rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasArenaCombatIdentityFields(data) {
      return data.keys().hasAll([
          "arenaIdentitySchemaVersion",
          "digimonInstanceId",
          "combatRevision"
        ]);
    }

    function hasValidArenaCombatIdentity(data) {
      return hasArenaCombatIdentityFields(data) &&
        data.arenaIdentitySchemaVersion == 1 &&
        data.digimonInstanceId is string &&
        data.digimonInstanceId.size() > 0 &&
        data.combatRevision is int &&
        data.combatRevision >= 1;
    }

    function isStrictArenaIdentityUpdateValid() {
      return hasValidArenaCombatIdentity(request.resource.data) &&
        request.resource.data.arenaIdentitySchemaVersion == resource.data.arenaIdentitySchemaVersion &&
        (
          (
            request.resource.data.digimonInstanceId == resource.data.digimonInstanceId &&
            request.resource.data.selectedDigimon == resource.data.selectedDigimon &&
            request.resource.data.combatRevision == resource.data.combatRevision
          ) ||
          (
            request.resource.data.digimonInstanceId == resource.data.digimonInstanceId &&
            request.resource.data.selectedDigimon != resource.data.selectedDigimon &&
            request.resource.data.combatRevision == resource.data.combatRevision + 1
          ) ||
          (
            request.resource.data.digimonInstanceId != resource.data.digimonInstanceId &&
            request.resource.data.combatRevision == 1
          )
        );
    }

    function isArenaSlotCreateValid() {
      return hasValidArenaCombatIdentity(request.resource.data) &&
        request.resource.data.selectedDigimon is string &&
        request.resource.data.selectedDigimon.size() > 0;
    }

    function isArenaSlotUpdateValid() {
      // bridge 기간에는 아직 backfill되지 않은 legacy slot만 기존 update를 허용한다.
      return !hasArenaCombatIdentityFields(resource.data) || isStrictArenaIdentityUpdateValid();
    }

    // 공식 관리 경계: 사용자 문서와 슬롯/로그
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /settings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }

      match /encyclopedia/{versionId} {
        allow read, write: if isOwner(userId);
      }

      match /slots/{slotId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isArenaSlotCreateValid();
        allow update: if isOwner(userId) && isArenaSlotUpdateValid();
        allow delete: if isOwner(userId);

        match /logs/{logId} {
          allow read, write: if isOwner(userId);
        }

        match /battleLogs/{logId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // 공식 관리 경계: 테이머명 중복 확인용 인덱스
    match /nickname_index/{normalizedKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.normalizedKey == normalizedKey;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.normalizedKey == normalizedKey;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 조그레스 정본과 보조 인덱스는 인증된 서버 API만 쓸 수 있다.
    match /jogress_rooms/{roomId} {
      allow read, write: if false;
    }

    match /jogress_room_owners/{ownerUid} {
      allow read, write: if false;
    }

    match /jogress_room_registrations/{registrationKey} {
      allow read, write: if false;
    }

    match /jogress_room_v3_migration_backups/{roomId} {
      allow read, write: if false;
    }

    match /jogress_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /arena_entries/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /arena_battle_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Ghost V2 정본은 Admin SDK/API만 쓸 수 있다.
    match /arena_ghosts/{ghostId} {
      allow read, write: if false;
    }

    match /arena_ghost_owners/{ownerUid} {
      allow read, write: if false;
    }

    match /arena_ghost_registrations/{registrationKey} {
      allow read, write: if false;
    }

    match /arena_combat_records/{combatIdentityId} {
      allow read, write: if false;
    }

    match /arena_season_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /arena_battles/{battleId} {
      allow read, write: if false;
    }

    // 실시간 아레나 public 상태는 두 참가자만 단일 문서로 읽는다.
    // 생성과 갱신은 서버 Admin SDK만 수행하며 collection list는 허용하지 않는다.
    match /realtimeArenaBattles/{battleId} {
      allow get: if isSignedIn() &&
        (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid);
      allow list, create, update, delete: if false;
    }

    // 미해결 행동과 서버 계산 근거는 클라이언트에 절대 노출하지 않는다.
    match /realtimeArenaBattleSecrets/{battleId} {
      allow read, write: if false;
    }

    match /arena_mirror_outbox/{jobId} {
      allow read, write: if false;
    }

    match /arena_archive_outbox/{jobId} {
      allow read, write: if false;
    }

    match /season_archives/{archiveId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 전역 설정은 서버 Admin SDK/API만 쓴다. 운영자 클라이언트도 예외가 아니다.
    match /game_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /{subPath=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }
  }
}
